@baseUrl = http://localhost:8000/api
@adminToken = {{loginAdmin.response.body.accessToken}}
@ownerToken = {{loginOwner.response.body.accessToken}}
@otherToken = {{loginOther.response.body.accessToken}}

### Logowanie ADMIN
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "admin-password-123" }

### Logowanie USER - właściciel rezerwacji 1
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "jan.kowalski@example.com", "password": "user-password-123" }

### Logowanie USER - obcy dla rezerwacji 1
# @name loginOther
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "anna.nowak@example.com", "password": "user-password-123" }


### GET /api/auth/me - brak tokenu
GET {{baseUrl}}/auth/me

### GET /api/auth/me - USER
GET {{baseUrl}}/auth/me
Authorization: Bearer {{ownerToken}}

### GET /api/auth/me - ADMIN
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}


### GET /api/buildings - brak tokenu
GET {{baseUrl}}/buildings

### GET /api/buildings - USER
GET {{baseUrl}}/buildings
Authorization: Bearer {{ownerToken}}

### GET /api/buildings - ADMIN
GET {{baseUrl}}/buildings
Authorization: Bearer {{adminToken}}


